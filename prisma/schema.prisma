// Prisma schema — Portfolio CMS Full-Stack
// Ref: spec_portfolio.md §36 (Modèle de données)

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (for the CLI / schema
// engine) and the runtime client uses a driver adapter — see src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MAINTENANCE
  ARCHIVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  AI
  MOBILE
  OTHER
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
  SPAM
}

enum AnalyticsEventType {
  PAGE_VIEW
  PROJECT_VIEW
  ARTICLE_VIEW
  GITHUB_CLICK
  LIVE_DEMO_CLICK
  CV_DOWNLOAD
  CONTACT_SUBMIT
  SOCIAL_CLICK
}

// ---------------------------------------------------------------------------
// Auth / Users  (§34)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(EDITOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  articles  Article[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Profile  (§8, §25)
// ---------------------------------------------------------------------------

model Profile {
  id                 String  @id @default(cuid())
  fullName           String
  headline           String
  shortBio           String  @db.Text
  bio                String  @db.Text
  philosophy         String? @db.Text
  objectives         String? @db.Text
  avatarUrl          String?
  location           String?
  availability       String?
  yearsOfExperience  Int     @default(0)
  projectsCount      Int     @default(0)
  technologiesCount  Int     @default(0)
  certificationsCount Int    @default(0)
  email              String?
  phone              String?
  whatsappNumber     String?
  whatsappMessage    String?
  cvUrlFr            String?
  cvUrlEn            String?
  isPrimary          Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  socialLinks SocialLink[]
}

model SocialLink {
  id           String  @id @default(cuid())
  platform     String
  url          String
  icon         String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?
}

// ---------------------------------------------------------------------------
// Projects  (§10, §11, §23)
// ---------------------------------------------------------------------------

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String        @db.Text
  description      String        @db.Text
  problem          String?       @db.Text
  solution         String?       @db.Text
  architecture     String?       @db.Text
  challenges       String?       @db.Text
  results          String?       @db.Text
  coverImage       String?
  gallery          String[]      @default([])
  githubUrl        String?
  liveUrl          String?
  startDate        DateTime?
  endDate          DateTime?
  status           ProjectStatus @default(IN_PROGRESS)
  featured         Boolean       @default(false)
  isPublished      Boolean       @default(false)
  displayOrder     Int           @default(0)
  views            Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category     Category?    @relation(fields: [categoryId], references: [id])
  categoryId   String?
  technologies Technology[] @relation("ProjectTechnologies")

  @@index([isPublished, displayOrder])
  @@index([featured])
}

model Technology {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  icon     String?
  color    String?
  category SkillCategory @default(OTHER)

  projects Project[] @relation("ProjectTechnologies")
}

// ---------------------------------------------------------------------------
// Skills  (§9, §24)
// ---------------------------------------------------------------------------

model Skill {
  id           String        @id @default(cuid())
  name         String
  category     SkillCategory
  level        Int           @default(50) // 0-100
  years        Float?
  icon         String?
  color        String?
  description  String?       @db.Text
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([category, displayOrder])
}

// ---------------------------------------------------------------------------
// Experience / Education / Certifications  (§12, §13, §14)
// ---------------------------------------------------------------------------

model Experience {
  id               String    @id @default(cuid())
  company          String
  position         String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  description      String?   @db.Text
  responsibilities String[]  @default([])
  technologies     String[]  @default([])
  logo             String?
  isCurrent        Boolean   @default(false)
  isVisible        Boolean   @default(true)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isVisible, displayOrder])
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  field        String?
  startDate    DateTime
  endDate      DateTime?
  description  String?   @db.Text
  location     String?
  logo         String?
  isVisible    Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isVisible, displayOrder])
}

model Certification {
  id               String    @id @default(cuid())
  name             String
  issuer           String
  issueDate        DateTime
  expirationDate   DateTime?
  credentialId     String?
  credentialUrl    String?
  certificateImage String?
  description      String?   @db.Text
  isVisible        Boolean   @default(true)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isVisible, displayOrder])
}

// ---------------------------------------------------------------------------
// Services  (§15)
// ---------------------------------------------------------------------------

model Service {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  icon         String?
  features     String[] @default([])
  price        String?
  featured     Boolean  @default(false)
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isVisible, displayOrder])
}

// ---------------------------------------------------------------------------
// Blog  (§16)
// ---------------------------------------------------------------------------

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImage     String?
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int           @default(0)
  views          Int           @default(0)
  likes          Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author     User?     @relation(fields: [authorId], references: [id])
  authorId   String?
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
  tags       Tag[]     @relation("ArticleTags")

  @@index([status, publishedAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  articles    Article[]
  projects    Project[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

// ---------------------------------------------------------------------------
// Testimonials  (§17)
// ---------------------------------------------------------------------------

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  position     String?
  company      String?
  avatar       String?
  content      String   @db.Text
  rating       Int      @default(5)
  featured     Boolean  @default(false)
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Contact messages  (§18, §19)
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Media library  (§26)
// ---------------------------------------------------------------------------

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  folder    String?
  provider  String   @default("local")
  createdAt DateTime @default(now())

  @@index([folder, createdAt])
}

// ---------------------------------------------------------------------------
// Analytics  (§21, §22)
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String             @id @default(cuid())
  eventType AnalyticsEventType
  path      String?
  entityId  String?
  sessionId String?
  country   String?
  device    String?
  browser   String?
  referrer  String?
  createdAt DateTime           @default(now())

  @@index([eventType, createdAt])
  @@index([path])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Site settings  (§27)
// ---------------------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit logs  (§35)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([createdAt])
  @@index([entity, entityId])
}
