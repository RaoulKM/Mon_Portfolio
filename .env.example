# ---------------------------------------------------------------------------
# Database (PostgreSQL) — spec §5
# Local: a standard connection string.
# Vercel + Neon/Supabase: use the POOLED connection string (pgbouncer).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mon_portfolio?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5 — spec §34
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
# On Vercel also set AUTH_URL to the canonical https URL and AUTH_TRUST_HOST=true
# ---------------------------------------------------------------------------
AUTH_SECRET=""
# AUTH_URL="https://your-app.vercel.app"
# AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Media storage — spec §5 (local | cloudinary | s3)
# For "cloudinary", the three CLOUDINARY_* values below are required.
# Find them in the Cloudinary dashboard → Settings → API Keys.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio"

# ---------------------------------------------------------------------------
# Email — spec §18 (optional in development)
# ---------------------------------------------------------------------------
EMAIL_SERVER=""
EMAIL_FROM="no-reply@localhost"

# ---------------------------------------------------------------------------
# Seed admin (used by prisma/seed.ts) — spec §49
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="kommboumepierreraoul@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe_12345"
SEED_ADMIN_NAME="KOM MBOUME PIERRE RAOUL"
